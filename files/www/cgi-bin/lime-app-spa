#!/bin/sh
# SPA Router for lime-app
# This script handles 404 errors and serves the index.html for client-side routing

# Get the requested path
REQUEST_URI="${REQUEST_URI:-$PATH_INFO}"

# ============================================================================
# SECTION 1: Main plugin routes (exact match)
# ============================================================================
# Public routes
case "$REQUEST_URI" in
    /rx|/metrics|/notes|/changenode|/locate|/meshwide)
        echo "Status: 301 Moved Permanently"
        echo "Location: /app${REQUEST_URI}"
        echo ""
        exit 0
        ;;
esac

# Protected routes (require authentication)
case "$REQUEST_URI" in
    /firstbootwizard|/netadmin|/nodeadmin|/firmware|/align|/remotesupport|/access)
        echo "Status: 301 Moved Permanently"
        echo "Location: /app${REQUEST_URI}"
        echo ""
        exit 0
        ;;
esac

# ============================================================================
# SECTION 2: Routes with dynamic sub-paths
# ============================================================================
case "$REQUEST_URI" in
    /firstbootwizard/*|/nodeadmin/*|/access/*|/align-single/*|/meshwide/*)
        echo "Status: 301 Moved Permanently"
        echo "Location: /app${REQUEST_URI}"
        echo ""
        exit 0
        ;;
esac

# ============================================================================
# SECTION 3: Additional specific routes
# ============================================================================
case "$REQUEST_URI" in
    /releaseinfo|/console)
        echo "Status: 301 Moved Permanently"
        echo "Location: /app${REQUEST_URI}"
        echo ""
        exit 0
        ;;
esac

# Check if requesting a lime-app route (starts with /app/)
case "$REQUEST_URI" in
    /app/*)
        # Extract route after /app/
        ROUTE="${REQUEST_URI#/app/}"
        
        # If it's a file with extension (like .js, .css, .svg), return 404
        case "$ROUTE" in
            *.js|*.css|*.svg|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.webp|*.json|*.html|*.map|*.woff|*.woff2|*.ttf|*.eot)
                echo "Status: 404 Not Found"
                echo "Content-Type: text/plain"
                echo ""
                echo "File not found"
                exit 0
                ;;
        esac
        
        # For routes without extension, serve index.html
        echo "Content-Type: text/html"
        echo ""
        cat /www/app/index.html
        exit 0
        ;;
esac

# Not a lime-app route, return 404
echo "Status: 404 Not Found"
echo "Content-Type: text/plain"
echo ""
echo "Not found"
